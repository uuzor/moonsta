# Solana RPC (mainnet by default; use a Helius/Triton key for production load)
RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_ENV=mainnet-beta

# Local services (docker compose up -d)
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
REDIS_URL=redis://localhost:6379

# Pricing
JUPITER_PRICE_URL=https://api.jup.ag/price/v3

# Agent signing key (base58). Generate: npm run keygen. Never commit.
AGENT_SECRET_KEY=

# Agent models (Meta Model API primary, optional OpenAI-compatible fallback)
MODEL_API_KEY=
MODEL_ID=muse-spark-1.3
MODEL_API_BASE=https://api.meta.ai/v1
# FALLBACK_API_BASE=
# FALLBACK_API_KEY=
# FALLBACK_MODEL_ID=

# Concurrency (memory drivers unless QUEUE_DRIVER=redis with a live daemon)
QUEUE_DRIVER=memory
TURN_HISTORY_LIMIT=40
TURN_LOCK_TTL_MS=300000
AGENT_MAX_TOOL_STEPS=30
AGENT_MAX_OUTPUT_TOKENS=8000

# Production Postgres password (prod compose only; generate a random one)
POSTGRES_PASSWORD=change-me

# Telegram (bot step)
TELEGRAM_BOT_TOKEN=
# Mini App dashboard: public https URL; when set, the bot pins it as the menu button
MINIAPP_URL=
# Web server port
PORT=3000

# Push data (guard step)
HELIUS_API_KEY=

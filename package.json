{
  "name": "sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "Moonsta — chat-native Solana guardian agent",
  "type": "commonjs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "report": "tsx scripts/report.ts",
    "guard": "tsx scripts/guard.ts",
    "worker": "tsx scripts/worker.ts",
    "keygen": "tsx scripts/keygen.ts",
    "policy": "tsx scripts/policy.ts",
    "agent": "tsx scripts/agent.ts",
    "bot": "tsx scripts/bot.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "web": "tsx scripts/web.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p apps/web/tsconfig.client.json",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
